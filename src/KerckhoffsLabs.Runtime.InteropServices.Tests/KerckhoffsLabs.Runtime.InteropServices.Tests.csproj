<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <!--
      Deliberately NOT set unconditionally here. UseMicrosoftTestingPlatformRunner=true generates
      the full Microsoft.Testing.Platform entry point (not the legacy standalone in-process console
      runner). The only reason to want it is so registered extensions such as coverlet.MTP's
      TestingPlatformBuilderHook can wire themselves in, and the only legs that collect coverage
      are the coverage steps in code-quality.yml, which pass -p:UseMicrosoftTestingPlatformRunner=true
      explicitly. Every other build/test leg has no use for it and gets the legacy runner instead.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Directory.Build.props turns on GenerateDocumentationFile repo-wide (IDE0005 only runs at
         build when it is set, see dotnet/roslyn#41640) and TreatWarningsAsErrors. This project has
         no public API to document — the public generic-math helper shims exist to reach static
         abstract members from tests — so CS1591 would be 300+ errors of pure noise here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!-- The suite is run twice (see CI): default = wide (nuint) build; -p:NativeCULongNarrow=true
       compiles the referenced library AND these tests with WINDOWS defined, exercising the narrow
       (uint) build. Has32BitStorage keys off #if WINDOWS to match the storage under test. -->
  <PropertyGroup Condition="'$(NativeCULongNarrow)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../KerckhoffsLabs.Runtime.InteropServices/KerckhoffsLabs.Runtime.InteropServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- coverlet.collector is the VSTest-collector shim; MTP-native runs (dotnet test's coverage
         option) need coverlet's own MTP extension instead. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
